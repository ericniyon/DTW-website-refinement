NODE_ENV=development
PORT=4000
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=
# Comma-separated. Local Vite origin plus the Vercel frontend URL(s).
CORS_ORIGIN=http://localhost:5173,https://your-frontend.vercel.app
ADMIN_EMAIL=
ADMIN_PASSWORD=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SPONSORSHIP_INBOX=

# Cloudinary — required for partner logo uploads from the admin dashboard.
# 1. Open https://console.cloudinary.com/settings/api-keys (account that owns DTW assets)
# 2. Copy Cloud name, API Key, and API Secret from the same row
#    Cloud name = the id in https://res.cloudinary.com/<cloud_name>/… (NOT "Root" or other display label)
# 3. Restart the backend after updating backend/.env (tsx does not reload .env on its own)
# Note: dc6iwekzx in the main site URLs is a different Cloudinary account — use YOUR cloud name here.
CLOUDINARY_CLOUD_NAME=dz6mis9ua
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder prefix (default: dtw2026/partners)
CLOUDINARY_FOLDER=dtw2026/partners
